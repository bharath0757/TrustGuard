# =============================================================================
# TrustGuard — environment variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.  Must match docker-compose.yml credentials.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://trustguard_user:changeme_dev_only@localhost:5432/trustguard

# Set to "true" to log all SQL statements to stderr (development only).
SQL_ECHO=false

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
JWT_SECRET=changeme_generate_a_random_secret
API_BASE_URL=http://localhost:8000
